# ÚNICO fichero que tienes que editar.
# Dominio: joseantonio.test -> cambia "tunombre" por tu nombre
DOMAIN=joseantonio.test
# Red privada 192.168.X (X = 56 o 57, nunca la .1 que es del anfitrión)
NET=192.168.56
PRIMARY_LAST=10
SECONDARY_LAST=11
# Contenido del registro TXT (tu usuario de GitHub o nombre completo)
TXT_VALUE="jasc-dotcom-github"
